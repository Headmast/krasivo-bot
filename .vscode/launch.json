{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Bun Script",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "bun",
            "runtimeArgs": [
                "--inspect-brk=0.0.0.0:9229",  // включаем инспектор и сразу останавливаем на первой строке
                "run",
                "${fileBasenameNoExtension}.ts"
            ],
            "program": "${workspaceFolder}/${fileBasenameNoExtension}.ts",
            "cwd": "${workspaceFolder}",
            "args": [],
            "env": {
                "TS_NODE_PROJECT": "${workspaceFolder}/tsconfig.json"
            },
            // ← вот что важно:
            "console": "integratedTerminal",  
            // или, если вам удобнее внешний:
            // "console": "externalTerminal",
            "internalConsoleOptions": "neverOpen",
            "preLaunchTask": "tsc: build - tsconfig.json",
            "sourceMaps": true,
            "outFiles": ["${workspaceFolder}/dist/**/*.js"],
            "resolveSourceMapLocations": [
                "${workspaceFolder}/**",
                "!**/node_modules/**"
            ]
        }
    ]
}